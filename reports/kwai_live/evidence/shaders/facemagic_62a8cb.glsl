uniform sampler2D depthTexture; uniform sampler2D faceTexture; uniform float faceArea; uniform float meanDepth; uniform float maskRatio; uniform int useBodyClip; varying vec2 textureCoordinate; void main() { vec4 faceColor = texture2D(faceTexture,textureCoordinate); vec4 depthColor = texture2D(depthTexture,textureCoordinate); gl_FragColor = vec4(depthColor.rgb,1.0); float dmOutput = 0.0; float depthNormUpper = 4.0; float depthFace = faceColor.r; float faceRangeRatio = 0.0; if (maskRatio > 0.04) { float meanDepthMin = min(1.1 * (meanDepth * 3.0 + 1.0), depthNormUpper); float depthColorB = depthColor.b * 3.0 + 1.0; if (faceArea > 0.06) { faceRangeRatio = 2.5*(1.0 - exp(-4.1*faceArea)); float faceNormLower = meanDepthMin - faceRangeRatio * (depthNormUpper - 1.0); depthFace = depthFace * (meanDepthMin-faceNormLower) + faceNormLower; dmOutput = (1.0 - depthColor.r)*depthColorB + (depthColor.r-depthColor.g)*depthFace + 0.7*depthColor.g*depthFace + 0.3*depthColor.g*depthColorB; dmOutput = (dmOutput - min(1.0, faceNormLower))/(depthNormUpper - min(1.0, faceNormLower)); } if (faceArea <= 0.06 && faceArea > 0.015) { faceRangeRatio = 3.0*(1.0 - exp(-4.1*faceArea)); float faceNormLower = meanDepthMin - faceRangeRatio * (depthNormUpper - 1.0); depthFace = depthFace * (meanDepthMin-faceNormLower) + faceNormLower; dmOutput = (1.0 - depthColor.r)*depthColorB + (depthColor.r-depthColor.g)*depthFace + 0.6*depthColor.g*depthFace + 0.4*depthColor.g*depthColorB; dmOutput = (dmOutput - min(1.0, faceNormLower))/(depthNormUpper - min(1.0, faceNormLower)); } if (faceArea <= 0.015) { dmOutput = (1.0 - depthColor.r)*depthColorB + (depthColor.r-depthColor.g)*meanDepthMin + 0.5*depthColor.g*meanDepthMin + 0.5*depthColor.g*depthColorB; dmOutput = (dmOutput - 1.0)/3.0; } } if (maskRatio <= 0.04) { dmOutput = depthColor.b; } if (useBodyClip == 1 && depthColor.r == 0.0) { dmOutput = 1.0; } gl_FragColor = vec4(dmOutput,dmOutput,dmOutput,1.0); }