uniform sampler2D inputAdjustMaskTex; uniform sampler2D inputFaceSegMask; uniform int segFlag; uniform float sliderDegree[4]; varying float eyeSide; uniform vec3 visibleDegree; void main() { lowp vec3 maskColor = texture2D(inputAdjustMaskTex, texCoords.xy).rgb; vec2 absPoseXY = texCoords.zw; lowp float segmask = 1.0; if (segFlag == 1 && (maskColor.r > 0.01 || maskColor.g > 0.01 || maskColor.b > 0.01)) segmask = texture2D(inputFaceSegMask, texCoords2).a; if (maskColor.r > 0.01 && maskColor.b > 0.01) { maskColor.rb = sliderDegree[1] * maskColor.rb * vec2(visibleDegree.x) * vec2(segmask); } if (maskColor.b > 0.01 && maskColor.r < 0.01) { lowp float occluded = step(0.0, eyeSide) * visibleDegree.y + step(eyeSide, 0.0) * visibleDegree.z; maskColor.b = sliderDegree[0] * maskColor.b * 0.5 * occluded * segmask; } if (maskColor.r > 0.01 && maskColor.b < 0.005) { maskColor.r = sliderDegree[2] * maskColor.r * absPoseXY.x * absPoseXY.y * segmask; } if (maskColor.g > 0.01 && maskColor.r < 0.005) { maskColor.g = sliderDegree[3] * maskColor.g * absPoseXY.y * segmask; } gl_FragColor = vec4(maskColor, 1.0); }